{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    d.id,\n                    d.info_hash,\n                    d.file_idx,\n                    d.name,\n                    d.total_bytes,\n                    d.downloaded_bytes,\n                    d.status as \"status: DownloadStatus\",\n                    d.error,\n                    d.created_at,\n                    d.completed_at\n                FROM downloads d\n                WHERE (d.info_hash, d.file_idx) IN (\n                    SELECT * FROM UNNEST($1::text[], $2::int4[])\n                )\n            ",
