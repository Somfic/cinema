  "query": "\n                SELECT pt.download_id, pt.only_audio, pt.audio_index\n                FROM pretranscodings pt\n                JOIN downloads d ON d.id = pt.download_id\n                WHERE pt.id = $1\n                FOR UPDATE OF d\n            ",
