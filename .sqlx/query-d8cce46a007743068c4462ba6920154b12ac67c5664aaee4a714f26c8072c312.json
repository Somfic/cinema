{
  "db_name": "PostgreSQL",
  "query": "SELECT\n                c.collection_slug as \"collection\",\n                mi.media_type as \"media_type: tmdb::MediaType\",\n                mi.tmdb_id,\n                mi.title,\n                mi.poster_path,\n                c.added_at,\n                c.position\n            FROM collections c\n            JOIN media_items mi ON mi.id = c.media_id\n            WHERE c.collection_slug = $1\n            ORDER BY c.position ASC, c.added_at DESC",
